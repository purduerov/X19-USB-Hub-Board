(version 1)

(rule "JLC pad to track"
    (condition "A.Type == 'Pad' && B.Type == 'Track'")
    (constraint clearance (min 0.1mm)))

(rule "JLC SMD pad to SMD pad (black mask dam)"
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
    (constraint clearance (min 0.15mm)))

(rule "JLC PTH annular ring"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X > 0.31mm")
    (constraint annular_width (min 0.15mm)))

(rule "JLC PTH hole to copper"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X > 0.31mm")
    (constraint hole_clearance (min 0.28mm)))

(rule "JLC pad hole to pad hole"
    (condition "A.Type == 'Pad' && B.Type == 'Pad' && A.Hole_Size_X > 0.31mm && B.Hole_Size_X > 0.31mm")
    (constraint hole_to_hole (min 0.45mm)))

(rule "JLC NPTH min hole"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
    (constraint hole_size (min 0.5mm)))


(rule upd_rule
    (condition "A.intersectsArea('upd_rule')")
    (constraint clearance (min 0.09mm))
    (constraint track_width (min 0.09mm)))
